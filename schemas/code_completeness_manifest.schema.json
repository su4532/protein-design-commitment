{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/denoising-dynamics/code-completeness-manifest.schema.json",
  "title": "Code completeness manifest",
  "type": "object",
  "required": ["version", "source_experiment_aliases", "entries"],
  "properties": {
    "version": {"const": 1},
    "source_experiment_aliases": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "kind", "title", "entrypoint", "configuration",
          "source_experiment", "required_inputs", "verification_fixture"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["method", "figure", "table", "result"]},
          "title": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string", "pattern": "^scripts/"},
          "configuration": {"type": "string", "pattern": "^configs/"},
          "source_experiment": {"type": "string", "minLength": 1},
          "required_inputs": {"type": "array", "items": {"type": "string"}},
          "verification_fixture": {"type": "string", "minLength": 1},
          "claim_fixture": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
